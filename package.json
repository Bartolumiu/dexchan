{
  "name": "dex-chan",
  "version": "1.0.4",
  "description": "Discord bot for MangaDex.",
  "main": "src/index.ts",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "start": "pnpm db:push && pnpm db:seed && tsx src/index.ts",
    "dev": "tsx src/index.ts",
    "test": "jest --coverage",
    "update": "pnpm up",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:references": "pnpm dlx knip",
    "check:dependencies": "pnpm dlx depcheck",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "i18n:push": "tsx --tsconfig tsconfig.json scripts/sync-export.ts && tolgee push",
    "i18n:pull": "tolgee pull && tsx --tsconfig tsconfig.json scripts/sync-import.ts && prettier --write \"src/i18n/locales/*.ts\""
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "transform": {
      "^.+\\.tsx?$": "ts-jest",
      "^.+\\.jsx?$": "babel-jest"
    },
    "testMatch": [
      "<rootDir>/tests/**/*.test.(ts)"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "<rootDir>/src/**/*.ts"
    ],
    "coverageDirectory": "<rootDir>/coverage",
    "coverageReporters": [
      "lcov",
      "text",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 0,
        "functions": 0,
        "lines": 0,
        "statements": 0
      }
    }
  },
  "keywords": [
    "discord",
    "bot",
    "mangadex",
    "namicomi",
    "dex-chan",
    "mangabaka"
  ],
  "author": "Bartolumiu",
  "license": "GPL-3.0",
  "dependencies": {
    "@prisma/adapter-pg": "~7.8.0",
    "@prisma/client": "~7.8.0",
    "chalk": "~5.6.2",
    "discord-api-types": "~0.38.49",
    "discord.js": "~14.26.4",
    "dotenv": "~17.4.2",
    "pg": "~8.22.0",
    "tsx": "~4.23.0"
  },
  "devDependencies": {
    "@jest/globals": "~30.4.1",
    "@tolgee/cli": "~2.20.0",
    "@types/node": "~26.1.0",
    "babel-jest": "~30.4.1",
    "jest": "~30.4.2",
    "prettier": "~3.9.4",
    "prisma": "~7.8.0",
    "ts-jest": "~29.4.11",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@11.13.0+sha512.88d94724d8f2e6c186744a5584c6e59ecac869ec7ba15e9cb4cd628e8dc7066820b2481d8ee3b51ea8da323a7378068aa58c556a3720d32b7c20a051d088363a"
}
