{
  "name": "dex-chan",
  "version": "1.0.6",
  "description": "Discord bot for MangaDex.",
  "main": "src/index.ts",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "start": "pnpm db:push && pnpm db:seed && tsx src/index.ts",
    "dev": "tsx src/index.ts",
    "test": "jest --coverage",
    "update": "pnpm up",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:references": "pnpm dlx knip",
    "check:dependencies": "pnpm dlx depcheck",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "i18n:push": "tsx --tsconfig tsconfig.json scripts/sync-export.ts && tolgee push",
    "i18n:pull": "tolgee pull && tsx --tsconfig tsconfig.json scripts/sync-import.ts && prettier --write \"src/i18n/locales/*.ts\""
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "transform": {
      "^.+\\.tsx?$": "ts-jest",
      "^.+\\.jsx?$": "babel-jest"
    },
    "testMatch": [
      "<rootDir>/tests/**/*.test.(ts)"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "<rootDir>/src/**/*.ts",
      "!<rootDir>/src/_generated/**/*.ts"
    ],
    "coverageDirectory": "<rootDir>/coverage",
    "coverageReporters": [
      "lcov",
      "text",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 0,
        "functions": 0,
        "lines": 0,
        "statements": 0
      }
    }
  },
  "keywords": [
    "discord",
    "bot",
    "mangadex",
    "namicomi",
    "dex-chan",
    "mangabaka"
  ],
  "author": "Bartolumiu",
  "license": "GPL-3.0",
  "dependencies": {
    "@prisma/adapter-pg": "~7.8.0",
    "@prisma/client": "~7.8.0",
    "chalk": "~5.6.2",
    "discord.js": "~14.27.0",
    "dotenv": "~17.4.2",
    "pg": "~8.22.0",
    "tsx": "~4.23.1"
  },
  "devDependencies": {
    "@jest/globals": "~30.4.1",
    "@tolgee/cli": "~2.20.0",
    "@types/node": "~26.1.1",
    "babel-jest": "~30.4.1",
    "jest": "~30.4.2",
    "prettier": "~3.9.5",
    "prisma": "~7.8.0",
    "ts-jest": "~29.4.11",
    "@typescript/native": "npm:typescript@~7.0.2",
    "typescript": "npm:@typescript/typescript6@~6.0.2"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72"
}
