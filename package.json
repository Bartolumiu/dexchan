{
  "name": "dex-chan",
  "version": "0.0.7",
  "description": "Discord bot for MangaDex.",
  "main": "src/index.ts",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "start": "tsx src/index.ts",
    "test": "jest --coverage",
    "update": "pnpm up",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:references": "pnpm dlx knip",
    "check:dependencies": "pnpm dlx depcheck"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "transform": {
      "^.+\\.tsx?$": "ts-jest",
      "^.+\\.jsx?$": "babel-jest"
    },
    "testMatch": [
      "<rootDir>/tests/**/*.test.(ts|js)"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "<rootDir>/src/**/*.ts"
    ],
    "coverageDirectory": "<rootDir>/coverage",
    "coverageReporters": [
      "lcov",
      "text",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 0,
        "functions": 0,
        "lines": 0,
        "statements": 0
      }
    }
  },
  "keywords": [
    "discord",
    "bot",
    "mangadex",
    "namicomi",
    "dex-chan",
    "mangabaka"
  ],
  "author": "Bartolumiu",
  "license": "GPL-3.0",
  "dependencies": {
    "@discordjs/rest": "~2.6.1",
    "@prisma/adapter-pg": "~7.8.0",
    "@prisma/client": "~7.8.0",
    "chalk": "~5.6.2",
    "discord-api-types": "~0.38.49",
    "discord.js": "~14.26.4",
    "dotenv": "~17.4.2",
    "pg": "~8.22.0",
    "tsx": "~4.23.0"
  },
  "devDependencies": {
    "@jest/globals": "~30.4.1",
    "@types/jest": "~30.0.0",
    "@types/pg": "~8.20.0",
    "babel-jest": "~30.4.1",
    "jest": "~30.4.2",
    "prettier": "~3.9.4",
    "prisma": "~7.8.0",
    "ts-jest": "~29.4.11",
    "typescript": "~6.0.3"
  },
  "knip": {
    "ignoreDependencies": [
      "jest"
    ],
    "ignoreBinaries": [
      "only-allow"
    ]
  },
  "packageManager": "pnpm@11.6.0"
}
